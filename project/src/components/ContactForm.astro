---
/**
 * Contact form.
 *
 * An ordinary HTML form that POSTs to /api/contact.php, so it works with
 * JavaScript off. The handler sends one email to the team for the chosen topic
 * and redirects to /contact/thanks/, or back here with a fragment naming the
 * error; the matching message below is shown with CSS :target.
 *
 * The topic values are the handler's allowlist (BETA_CONTACT_TOPICS in
 * public/api/beta-lib.inc); keep the two in step. Which mailbox each topic
 * reaches is set only in the private server config, never in this page.
 * `topic` preselects one of them (the /feedback/ page uses "app_feedback");
 * the visitor can still change it.
 *
 * The one script records how long the form was open, for the handler's
 * minimum-fill-time check. Editing it changes its CSP hash in
 * public/.htaccess.
 */

import Button from "./Button.astro";
import Icon from "./Icon.astro";

interface Props {
  /** A topic value to preselect. */
  topic?: string;
}

const { topic } = Astro.props;

const fieldClass =
  "w-full rounded-[14px] border-2 border-teal-muted bg-paper px-4 py-3.5 text-[1.0625rem] " +
  "text-teal-deep placeholder:text-teal-mid transition-colors " +
  "focus:border-teal-deep";
const selectClass = `${fieldClass} truncate`;
const labelClass = "mb-2 block text-[0.95rem] font-bold text-teal-deep";

const topics = [
  { value: "support", label: "Support" },
  { value: "app_feedback", label: "App feedback" },
  { value: "sales_partnerships", label: "Sales & partnerships" },
  { value: "careers", label: "Careers" },
  { value: "privacy", label: "Privacy" },
  { value: "finance", label: "Finance" },
];
/* An unknown value preselects nothing, so the placeholder stays selected. */
const selected = topics.some((t) => t.value === topic) ? topic : undefined;

const errors = [
  {
    id: "error-fields",
    text: "Please check the form: a topic, your first name, a valid email address and a message (up to 2,000 characters) are needed.",
  },
  {
    id: "error-retry",
    text: "That was quicker than we expected. Please check your message and send it again.",
  },
  {
    id: "error-rate",
    text: "We have had several messages from your connection. Please wait an hour and try again.",
  },
  {
    id: "error-unavailable",
    text: "Sorry, the form is unavailable. Please email support@tetherhealthgroup.com.",
  },
];
---

<div>
  {
    errors.map((error) => (
      <p
        id={error.id}
        tabindex="-1"
        class="mb-6 hidden items-start gap-2.5 rounded-2xl border-2 border-coral bg-paper p-4 font-bold text-teal-deep target:flex"
      >
        <Icon name="alert" size={20} class="mt-0.5 shrink-0" />
        <span>{error.text}</span>
      </p>
    ))
  }

  <form
    id="contact-form"
    method="post"
    action="/api/contact.php"
    class="grid gap-5 sm:grid-cols-2"
  >
    <div class="sm:col-span-2">
      <label class={labelClass} for="ct-topic">Topic</label>
      <select class={selectClass} id="ct-topic" name="topic" required>
        <option value="" selected={!selected} disabled>Choose a topic</option>
        {
          topics.map((t) => (
            <option value={t.value} selected={t.value === selected}>
              {t.label}
            </option>
          ))
        }
      </select>
    </div>

    <div>
      <label class={labelClass} for="ct-first-name">First name</label>
      <input
        class={fieldClass}
        id="ct-first-name"
        name="first_name"
        type="text"
        required
        maxlength="80"
        autocomplete="given-name"
        placeholder="Your first name"
      />
    </div>

    <div>
      <label class={labelClass} for="ct-email">Email</label>
      <input
        class={fieldClass}
        id="ct-email"
        name="email"
        type="email"
        required
        maxlength="254"
        autocomplete="email"
        placeholder="you@example.com"
      />
    </div>

    <div class="sm:col-span-2">
      <label class={labelClass} for="ct-organisation"
        >Organisation <span class="font-normal text-teal-mid">(optional)</span
        ></label
      >
      <input
        class={fieldClass}
        id="ct-organisation"
        name="organisation"
        type="text"
        maxlength="120"
        autocomplete="organization"
        placeholder="Health system, company or university"
      />
    </div>

    <div class="sm:col-span-2">
      <label class={labelClass} for="ct-message">Message</label>
      <textarea
        class={`${fieldClass} min-h-36 resize-y`}
        id="ct-message"
        name="message"
        rows="5"
        required
        maxlength="2000"
        aria-describedby="ct-message-help"
        placeholder="How can we help?"></textarea>
      <p
        id="ct-message-help"
        class="mt-2 text-sm leading-relaxed text-teal-mid"
      >
        Up to 2,000 characters. Please do not include medical details.
      </p>
    </div>

    {/* Honeypot: a field no person sees and no person fills in. */}
    <div class="hidden" aria-hidden="true">
      <label for="ct-contact-ref">Leave this empty</label>
      <input
        id="ct-contact-ref"
        name="contact_ref"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>
    <input type="hidden" name="fill_ms" value="" />

    <div class="sm:col-span-2">
      <Button type="submit" arrow full class="sm:w-auto">Send message</Button>
      <p class="mt-4 text-sm leading-relaxed text-teal-mid">
        We'll use this only to reply. Read the <a
          href="/privacy/"
          class="font-bold text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4"
          >privacy notice</a
        >.
      </p>
    </div>
  </form>
</div>

<script>
  /* Record how long the form was open, on the visitor's own clock. */
  const started = performance.now();
  const form = document.getElementById("contact-form");
  if (form instanceof HTMLFormElement) {
    form.addEventListener("submit", () => {
      const field = form.elements.namedItem("fill_ms");
      if (field instanceof HTMLInputElement) {
        field.value = String(Math.round(performance.now() - started));
      }
    });
  }
</script>
