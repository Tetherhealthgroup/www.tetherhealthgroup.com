---
// Editing the inline-script text changes its CSP hash in public/.htaccess.
/**
 * The body of a FHIR OAuth redirect page. See src/lib/fhir-callback.ts for
 * when this renders at all, and why the authorization code is never shown.
 *
 * Every outcome is a hidden block; the script reveals one. With scripting off,
 * the <noscript> line is the whole page.
 */

import Section from "./Section.astro";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import { androidApp } from "../data/site";

interface Props {
  /** The record source, as a visitor would name it. */
  provider: string;
}

const { provider } = Astro.props;
---

<Section width="narrow" space="loose">
  <div
    id="fhir-callback"
    data-package={androidApp.packageName}
    class="rounded-3xl border border-hairline-soft bg-paper p-8 text-center shadow-[var(--shadow-card)] sm:p-12"
  >
    <span
      class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-3xl bg-mint text-teal-deep"
    >
      <Icon name="lock" size={26} />
    </span>

    <h1 class="text-3xl sm:text-4xl">Connecting your {provider} records</h1>

    <div id="cb-android" class="hidden">
      <p class="mt-5 text-lg leading-relaxed">
        Return to Tether Health to finish connecting your {provider} records.
      </p>
      <div class="mt-8 flex justify-center">
        <Button id="cb-open" href="/" arrow>Open Tether Health</Button>
      </div>
    </div>

    <p id="cb-other-device" class="mt-5 hidden text-lg leading-relaxed">
      Open Tether Health on the phone where you started to finish connecting.
      You can close this tab.
    </p>

    <p id="cb-denied" class="mt-5 hidden text-lg leading-relaxed">
      You chose not to share your {provider} records, so nothing was shared. You can
      connect them later from the Tether Health app.
    </p>

    <p id="cb-error" class="mt-5 hidden text-lg leading-relaxed">
      The connection to {provider} was not completed, and nothing was shared. Return
      to the Tether Health app to try again.
    </p>

    <p id="cb-empty" class="mt-5 hidden text-lg leading-relaxed">
      This page finishes a {provider} connection started in the Tether Health app.
      There is nothing to do here on its own.
    </p>

    <noscript>
      <p class="mt-5 text-lg leading-relaxed">
        Return to the Tether Health app to finish connecting your {provider} records.
      </p>
    </noscript>
  </div>
</Section>

<script>
  import { appIntentUrl, callbackOutcome } from "../lib/fhir-callback";

  const root = document.getElementById("fhir-callback");

  if (root instanceof HTMLElement) {
    const { host, pathname, search } = window.location;

    /* Take the one-time code out of the address bar and the history entry
       before anything else, so it is not left behind in a shared browser or
       sent as a Referer by a later click. */
    if (search) window.history.replaceState(null, "", pathname);

    const outcome = callbackOutcome(search, navigator.userAgent);
    document.getElementById(`cb-${outcome}`)?.classList.remove("hidden");

    const open = document.getElementById("cb-open");
    const packageName = root.dataset.package ?? "";
    if (outcome === "android" && open instanceof HTMLAnchorElement) {
      open.href = appIntentUrl(host, pathname, search, packageName);
    }
  }
</script>
