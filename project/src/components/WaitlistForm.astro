---
// needs-counsel: WEB-005 — button label, privacy line, noscript text, the
// message help text and the inline-script strings (subject fallback, two
// confirmations). Editing the script text changes its CSP hash in
// public/.htaccess.
/**
 * Waitlist form.
 *
 * Delivery has two modes, decided at build time:
 *
 *   1. PUBLIC_WAITLIST_ENDPOINT is set — the form POSTs JSON to that URL.
 *   2. It is not set (the default) — the form composes the message in the
 *      visitor's own mail client, addressed to support@tetherhealthgroup.com.
 *
 * Mode 2 is the default deliberately. The site is statically hosted with no
 * backend, and a form that silently drops submissions is worse than one that
 * hands the visitor a message they can see themselves send.
 *
 * Both modes need the script: there is no server to POST to and no action to
 * fall back on, so with scripting unavailable the <noscript> block below hides
 * the form and prints the address instead. The footer also carries the address
 * on every page, which is the route left if the script fails to run at all.
 *
 * No health information is requested. The prompt asks which area someone is
 * interested in, not whether they have a condition — an important distinction
 * for a form that travels by ordinary email.
 */

import Button from "./Button.astro";
import Icon from "./Icon.astro";
import { waitlist } from "../data/site";
import { programs } from "../data/programs";
import SupportEmail from "./SupportEmail.astro";

interface Props {
  class?: string;
}

const { class: className = "" }: Props = Astro.props;

const endpoint = import.meta.env.PUBLIC_WAITLIST_ENDPOINT ?? "";

const roles = [
  "Someone who wants to quit or make a change",
  "Clinician or care-team member",
  "Employer, health plan or public-health organisation",
  "Researcher or academic",
  "Something else",
];

/*
 * The border darkens on focus, but that is the *second* indicator, not the
 * only one. focus:outline-none used to sit here: it removed the global
 * :focus-visible ring, and WebKit does not apply the replacement border, so a
 * focused field showed no indicator at all in Safari — on iPhone and on Mac.
 * Chromium hid the bug by applying the border. Keeping the site's own ring
 * means the indicator does not depend on one engine's behaviour.
 */
const fieldClass =
  "w-full rounded-[14px] border-2 border-teal-muted bg-paper px-4 py-3.5 text-[1.0625rem] " +
  "text-teal-deep placeholder:text-teal-mid transition-colors " +
  "focus:border-teal-deep";

const labelClass = "mb-2 block text-[0.95rem] font-bold text-teal-deep";
---

<div class={className}>
  <form
    id="waitlist-form"
    class="grid gap-5 sm:grid-cols-2"
    data-endpoint={endpoint}
    data-email={waitlist.email}
    data-subject={waitlist.subject}
    novalidate
  >
    <div class="sm:col-span-1">
      <label class={labelClass} for="wl-name"
        >Name <span class="font-normal text-teal-mid">(optional)</span></label
      >
      <input
        class={fieldClass}
        id="wl-name"
        name="name"
        type="text"
        autocomplete="name"
        placeholder="Your name"
      />
    </div>

    <div class="sm:col-span-1">
      <label class={labelClass} for="wl-email">Email</label>
      <input
        class={fieldClass}
        id="wl-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
        aria-describedby="wl-email-error"
      />
      <p
        id="wl-email-error"
        class="mt-2 hidden items-center gap-1.5 text-sm font-bold text-teal-deep"
        role="alert"
      >
        <Icon name="alert" size={16} />
        <span>Please enter an email address we can reply to.</span>
      </p>
    </div>

    <div class="sm:col-span-1">
      <label class={labelClass} for="wl-role">I am</label>
      <select class={fieldClass} id="wl-role" name="role">
        {roles.map((role) => <option value={role}>{role}</option>)}
      </select>
    </div>

    <div class="sm:col-span-1">
      <label class={labelClass} for="wl-interest">
        Health area of interest
      </label>
      <select class={fieldClass} id="wl-interest" name="interest">
        <option value="Any / not sure yet">Any — not sure yet</option>
        {
          programs.map((program) => (
            <option value={program.area}>{program.area}</option>
          ))
        }
      </select>
    </div>

    <div class="sm:col-span-2">
      <label class={labelClass} for="wl-message">
        Anything you would like us to know <span
          class="font-normal text-teal-mid">(optional)</span
        >
      </label>
      <textarea
        class={`${fieldClass} min-h-28 resize-y`}
        id="wl-message"
        name="message"
        rows="3"
        placeholder="What would make this genuinely useful for you?"></textarea>
      <p class="mt-2 text-sm leading-relaxed text-teal-mid">
        Please do not include medical details. This message travels by ordinary
        email. Want to test an Android version if we offer one? Say so here.
      </p>
    </div>

    {/* Honeypot: a field no person sees and no person fills in. */}
    <div class="hidden" aria-hidden="true">
      <label for="wl-company">Company</label>
      <input
        id="wl-company"
        name="company"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class="sm:col-span-2">
      <Button type="submit" arrow full class="sm:w-auto">
        Join the waitlist
      </Button>
      <p class="mt-4 text-sm leading-relaxed text-teal-mid">
        We use your address to reply about the waitlist and nothing else. No
        marketing lists, no third-party trackers, and we never sell contact
        details. Read the <a
          href="/privacy/"
          class="font-bold text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4"
          >privacy notice</a
        >.
      </p>
    </div>
  </form>

  <!-- Shown after a successful submission. -->
  <div
    id="waitlist-success"
    class="hidden rounded-3xl border border-mint-strong bg-mint p-7"
    role="status"
  >
    <span
      class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-teal-deep text-lime"
    >
      <Icon name="check" size={24} />
    </span>
    <h3 class="mb-2 text-xl">Thank you — that is everything we need.</h3>
    <p id="waitlist-success-body" class="text-teal-mid"></p>
  </div>

  <!--
    The address in plain text: the form's fallback with JavaScript off.

    The <style> removes the form itself. Delivery is entirely the script's
    job — the site is static, so the form has no action to fall back to, and
    submitting it without the script reloaded the page and discarded whatever
    had been typed. A control that cannot do what it says is worse than no
    control, so with scripting unavailable the address replaces it rather than
    sitting underneath it. Inline style, not script, so it applies in exactly
    the case it describes; style-src allows 'unsafe-inline'.
  -->
  <noscript>
    <style>
      #waitlist-form {
        display: none;
      }
    </style>
    <p class="rounded-3xl border border-hairline bg-paper p-5 text-teal-mid">
      Joining the waitlist needs JavaScript, because this site is static and has
      no server to receive the form. Email us directly at <SupportEmail
        subject={waitlist.subject}
        class="font-bold text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4"
      /> and it reaches the same inbox.
    </p>
  </noscript>
</div>

<script>
  import {
    isReplyableEmail,
    normalizeWaitlistPayload,
    waitlistMailtoUrl,
  } from "../lib/waitlist";

  const form = document.getElementById("waitlist-form");
  const success = document.getElementById("waitlist-success");
  const successBody = document.getElementById("waitlist-success-body");
  const emailError = document.getElementById("wl-email-error");

  if (
    form instanceof HTMLFormElement &&
    success instanceof HTMLElement &&
    successBody instanceof HTMLElement &&
    emailError instanceof HTMLElement
  ) {
    const endpoint = form.dataset.endpoint ?? "";
    const address = form.dataset.email ?? "";
    const subject = form.dataset.subject ?? "Waitlist request";

    const emailField = form.elements.namedItem("email");

    const showError = (show: boolean) => {
      emailError.classList.toggle("hidden", !show);
      emailError.classList.toggle("flex", show);
      if (emailField instanceof HTMLInputElement) {
        emailField.setAttribute("aria-invalid", show ? "true" : "false");
        emailField.classList.toggle("border-coral", show);
      }
    };

    const finish = (message: string) => {
      form.classList.add("hidden");
      success.classList.remove("hidden");
      successBody.textContent = message;
      /* Move focus to the confirmation so screen-reader users are told the
         submission worked, rather than being left on a form that vanished. */
      success.setAttribute("tabindex", "-1");
      success.focus();
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const data = new FormData(form);

      /* A filled honeypot means a bot. Show the same confirmation a person
         sees rather than an error, so the bot learns nothing. */
      if ((data.get("company") as string)?.trim()) {
        finish("Thank you — we will be in touch.");
        return;
      }

      const payload = normalizeWaitlistPayload({
        name: data.get("name") as string,
        email: data.get("email") as string,
        role: data.get("role") as string,
        interest: data.get("interest") as string,
        message: data.get("message") as string,
      });

      if (!isReplyableEmail(payload.email)) {
        showError(true);
        if (emailField instanceof HTMLInputElement) emailField.focus();
        return;
      }
      showError(false);

      if (endpoint) {
        try {
          const response = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          finish(
            "We have your request and will reply to " +
              payload.email +
              " when we have news.",
          );
          return;
        } catch (error) {
          /* Fall through to the mail-client route rather than losing the
             submission. The visitor still gets a way to reach us. */
          console.error(
            "Waitlist endpoint failed, falling back to email",
            error,
          );
        }
      }

      window.location.href = waitlistMailtoUrl(address, subject, payload);

      finish(
        `Your email app should now be open with a message to ${address}. ` +
          "Send it and we will reply when we have news. If nothing " +
          `opened, email ${address} directly.`,
      );
    });

    /* Clear the error as soon as the visitor starts correcting it. */
    if (emailField instanceof HTMLInputElement) {
      emailField.addEventListener("input", () => showError(false));
    }
  }
</script>
