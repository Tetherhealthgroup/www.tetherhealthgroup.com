---
/**
 * One health area from the programme plan, with an honest status badge.
 *
 * The badge is the point of this component. Ten areas are listed, one is being
 * built, and the card must never let those read the same.
 */

import Icon from "./Icon.astro";
import { statusLabels, type Program } from "../data/programs";

interface Props {
  program: Program;
  /** Compact cards omit the "could address" list. */
  compact?: boolean;
}

const { program, compact = false } = Astro.props;
const isBuilding = program.status === "building";
---

<article
  class:list={[
    "relative flex h-full flex-col rounded-3xl border p-6 shadow-[var(--shadow-card)] transition-all duration-200 ease-[var(--ease-calm)]",
    isBuilding
      ? "border-teal-deep/25 bg-paper ring-1 ring-teal-deep/10"
      : "border-hairline-soft bg-paper/70",
  ]}
>
  <div class="mb-5 flex items-start justify-between gap-3">
    <span
      class:list={[
        "inline-flex h-12 w-12 items-center justify-center rounded-2xl",
        isBuilding ? "bg-teal-deep text-lime" : "bg-mint text-teal-mid",
      ]}
    >
      <Icon name={program.icon} size={22} />
    </span>

    <span
      class:list={[
        "inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-[0.7rem] font-extrabold uppercase tracking-[0.12em]",
        isBuilding
          ? "bg-lime text-teal-deep"
          : "bg-mint-pale text-teal-muted ring-1 ring-hairline-soft",
      ]}
    >
      {
        isBuilding && (
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal-deep opacity-60" />
            <span class="relative inline-flex h-2 w-2 rounded-full bg-teal-deep" />
          </span>
        )
      }
      {statusLabels[program.status]}
    </span>
  </div>

  <h3 class:list={["text-xl", isBuilding ? "" : "text-teal-deep/80"]}>
    {program.area}
  </h3>
  <p class="mt-2 text-[0.95rem] leading-relaxed text-teal-muted">
    {program.examples}
  </p>

  {
    !compact && (
      <ul class="mt-5 flex flex-wrap gap-2">
        {program.addresses.map((item) => (
          <li class="rounded-full bg-mint-pale px-3 py-1.5 text-[0.8rem] font-bold text-teal-mid">
            {item}
          </li>
        ))}
      </ul>
    )
  }

  {
    program.product && (
      <a
        href={program.product.href}
        class="mt-6 inline-flex items-center gap-2 rounded-xl text-[0.95rem] font-bold text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4 transition-colors hover:decoration-coral"
      >
        Meet {program.product.name}
        <Icon name="arrow-right" size={17} />
      </a>
    )
  }
</article>
