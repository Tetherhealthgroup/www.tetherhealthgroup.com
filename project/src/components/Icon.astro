  | "users"
  | "stethoscope"
  | "calendar"
  | "spark"
  | "info"
  | "alert"
  | "arrow-right"
  | "trash"
  | "globe";

interface Props {
  name: IconName;
  size?: number;
  /** Accessible name. Omit for decorative icons. */
  title?: string;
  class?: string;
}

const { name, size = 24, title, class: className = "" } = Astro.props;

