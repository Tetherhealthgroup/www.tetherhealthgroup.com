---
/**
 * Line-icon set drawn to match the approved artwork: 24-unit box, 2px stroke,
 * round caps and joins, no fills. Every icon here corresponds to something the
 * app actually shows — the five tab-bar icons, the coping tools, the privacy
 * controls — rather than a generic icon library.
 *
 * Icons are decorative by default (aria-hidden). Pass a `title` only when the
 * icon carries meaning no adjacent text repeats.
 */

export type IconName =
  | "home"
  | "plan"
  | "progress"
  | "learn"
  | "support"
  | "check"
  | "plus"
  | "leaf"
  | "shield"
  | "lock"
  | "clock"
  | "coins"
  | "wave"
  | "phone"
  | "bell"
  | "download"
  | "eye-off"
  | "accessibility"
