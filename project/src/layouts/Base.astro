---
/**
 * The single page shell: document head, skip link, header, main, footer.
 *
 * Every route renders through this layout so the landmark structure, metadata
 * shape and focus order are identical site-wide.
 */

import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** Omit the site name suffix, for the home page which carries it already. */
  bareTitle?: boolean;
  /** Discourage indexing, e.g. for the 404 page. */
  noindex?: boolean;
}

const { title, description, bareTitle = false, noindex = false } = Astro.props;

const pageTitle = bareTitle ? title : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

/* The share card. twitter:card is "summary_large_image", which promises an
   image; without one the card renders empty, which is worse than not
   declaring it. Absolute URL because Open Graph consumers do not resolve
   relative paths. */
const ogImage = new URL("/og-image.png", Astro.site ?? site.url).href;

/* Organization + product structured data. Only facts present in this
   repository are described: name, domain, and the product's purpose. No
   rating, founder, address or claim of certification is asserted. */
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site.url}/#organization`,
      name: site.name,
      legalName: site.legalName,
      url: site.url,
      description: site.description,
    },
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      url: site.url,
      name: site.name,
      publisher: { "@id": `${site.url}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#123C37" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Tether Health Group — care that meets people where they are. First program in development."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="generator" content={Astro.generator} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>

  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-2xl focus:bg-teal-deep focus:px-5 focus:py-3 focus:font-bold focus:text-paper"
      >Skip to main content</a
    >

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
