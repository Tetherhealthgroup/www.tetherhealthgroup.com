---
/**
 * Shell for the long-form policy pages, so their structure, measure and
 * "last updated" treatment stay identical.
 */

import Base from "./Base.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import Icon from "../components/Icon.astro";
import SupportEmail from "../components/SupportEmail.astro";
import type { Mailbox } from "../data/site";
import { formatLegalDate } from "../lib/legal-date";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  intro: string;
  /** ISO date this document was last changed. */
  updated: string;
  /** Optional note shown in a highlighted box above the body. */
  scopeNote?: string;
  /** Role mailbox for the closing "Questions" block; defaults to support. */
  contactMailbox?: Mailbox;
}

const {
  title,
  description,
  eyebrow,
  intro,
  updated,
  scopeNote,
  contactMailbox = "support",
} = Astro.props;

const updatedLabel = formatLegalDate(updated);
---

<Base title={title} description={description}>
  <PageHero eyebrow={eyebrow} title={title} intro={intro} width="narrow">
    <p class="mt-7 text-[0.95rem] font-bold text-teal-mid">
      Last updated <time datetime={updated}>{updatedLabel}</time>
    </p>
  </PageHero>

  <Section width="narrow">
    {
      scopeNote && (
        <p class="mb-12 flex items-start gap-3 rounded-3xl border border-mint-strong bg-mint p-6 leading-relaxed text-teal-mid">
          <Icon name="info" size={20} class="mt-0.5 shrink-0 text-teal-deep" />
          <span>{scopeNote}</span>
        </p>
      )
    }

    <div class="prose-tether">
      <slot />
    </div>

    <div class="mt-16 rounded-3xl border border-hairline-soft bg-paper p-7">
      <h2 class="text-xl">Questions about this document</h2>
      <p class="mt-3 leading-relaxed text-teal-mid">
        Write to <SupportEmail
          mailbox={contactMailbox}
          class="font-bold text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4"
        />. Please do not include medical details.
      </p>
    </div>
  </Section>
</Base>
