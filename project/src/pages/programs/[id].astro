---
/**
 * One page per program of the Tether Health app, one program per health area.
 *
 * The name, area, archetype, tagline and colour are the app's own
 * (data/programs.ts). Only BreatheFree has a product page to link to. No
 * program is released yet, so the call to action is early access, never a
 * download.
 */

import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Section from "../../components/Section.astro";
import Button from "../../components/Button.astro";
import Icon from "../../components/Icon.astro";
import WaitlistForm from "../../components/WaitlistForm.astro";
import { programs } from "../../data/programs";
import type { Program } from "../../data/programs";

export function getStaticPaths() {
  return programs.map((program) => ({
    params: { id: program.id },
    props: { program },
  }));
}

interface Props {
  program: Program;
}

const { program } = Astro.props;
---

<Base
  title={`${program.name} · ${program.area}`}
  description={`${program.name}, the Tether Health app program for ${program.area.toLowerCase()}: ${program.tagline}`}
>
  <PageHero
    eyebrow={`${program.area} · ${program.archetype}`}
    title={program.name}
    intro={program.tagline}
  >
    <p
      class="mt-7 flex items-center gap-3 text-[0.95rem] font-bold text-teal-mid"
    >
      <span
        class="inline-flex h-9 w-9 items-center justify-center rounded-xl text-base font-extrabold text-paper"
        style={`background-color: ${program.color}`}
        aria-hidden="true">{program.letter}</span
      >
      {program.examples}
    </p>
  </PageHero>

  <!-- Overview -->
  <Section space="tight" width="default">
    <div class="rounded-3xl border border-hairline-soft bg-paper p-7 sm:p-9">
      <p class="text-lg leading-relaxed text-teal-mid">{program.summary}</p>
    </div>
  </Section>

  <!-- Services: what the program includes -->
  <Section space="tight" width="wide">
    <div class="mb-10 max-w-3xl">
      <p class="eyebrow mb-5">What it includes</p>
      <h2 class="text-3xl sm:text-4xl">What {program.name} helps with.</h2>
      <p class="mt-5 leading-relaxed text-teal-mid">
        Every part of {program.name} follows the same principles as the rest of Tether
        Health: private by design, no judgment, and a route to a real person.
      </p>
    </div>

    <ul class="grid gap-6 md:grid-cols-2">
      {
        program.services.map((service) => (
          <li class="rounded-3xl border border-hairline-soft bg-paper p-7">
            <span class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-mint text-teal-deep">
              <Icon name={program.icon} size={20} />
            </span>
            <h3 class="text-xl">{service.name}</h3>
            <p class="mt-2 leading-relaxed text-teal-mid">
              {service.description}
            </p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Product, where one exists -->
  {
    program.product && (
      <Section space="tight" width="default">
        <div class="rounded-3xl border-2 border-teal-deep bg-paper p-8">
          <p class="eyebrow mb-4">Featured program</p>
          <h2 class="text-3xl">{program.product.name}</h2>
          <p class="mt-4 max-w-2xl leading-relaxed text-teal-mid">
            See how {program.product.name} works, from the first check-in to the
            craving at 11pm — screen by screen.
          </p>
          <div class="mt-7">
            <Button href={program.product.href} arrow>
              Meet {program.product.name}
            </Button>
          </div>
        </div>
      </Section>
    )
  }

  <!-- Back to the full list, and early access -->
  <Section space="tight" width="default">
    <p class="text-teal-mid">
      <a
        href="/programs/"
        class="font-bold text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4"
        >See all programs</a
      > and what each one does.
    </p>
  </Section>

  <Section tone="mint" width="default" id="waitlist">
    <div class="mb-10 max-w-2xl">
      <p class="eyebrow mb-5">Early access</p>
      <h2 class="text-3xl sm:text-4xl">
        Be among the first to use {program.name}.
      </h2>
      <p class="mt-5 leading-relaxed text-teal-mid">
        Request early access and tell us which area matters to you. We will
        write to you as places become available.
      </p>
    </div>
    <WaitlistForm />
  </Section>
</Base>
