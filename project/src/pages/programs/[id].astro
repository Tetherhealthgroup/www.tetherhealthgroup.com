---
/**
 * One page per program of the Tether Health app, one program per health area.
 *
 * The name, area, archetype, tagline and colour are the app's own
 * (data/programs.ts). Only BreatheFree has a product page to link to. No
 * program is released yet, so the call to action is early access at /beta/,
 * never a download.
 *
 * WEB-915 (P-113): each page also carries an intro video, three screens from
 * the app design, an introduction to the health area (marked for clinical
 * review), what the app helps with and the recovery plan, all from
 * data/program-pages.ts.
 */

import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Section from "../../components/Section.astro";
import Button from "../../components/Button.astro";
import Icon from "../../components/Icon.astro";
import ProgramShowcase from "../../components/ProgramShowcase.astro";
import { programs } from "../../data/programs";
import type { Program } from "../../data/programs";
import {
  programPageById,
  programDisclaimer,
  clinicalReviewMarker,
} from "../../data/program-pages";

export function getStaticPaths() {
  return programs.map((program) => ({
    params: { id: program.id },
    props: { program },
  }));
}

interface Props {
  program: Program;
}

const { program } = Astro.props;
const page = programPageById.get(program.id);
if (!page) throw new Error(`No program page content for ${program.id}`);
---

<Base
  title={`${program.name} · ${program.area}`}
  description={`${program.name}, the Tether Health app program for ${program.area.toLowerCase()}: ${program.tagline}`}
>
  <PageHero
    eyebrow={`${program.area} · ${program.archetype}`}
    title={program.name}
    intro={program.tagline}
  >
    <p
      class="mt-7 flex items-center gap-3 text-[0.95rem] font-bold text-teal-mid"
    >
      <span
        class="inline-flex h-9 w-9 items-center justify-center rounded-xl text-base font-extrabold text-paper"
        style={`background-color: ${program.color}`}
        aria-hidden="true">{program.letter}</span
      >
      {program.examples}
    </p>
  </PageHero>

  <!-- Overview -->
  <Section space="tight" width="default">
    <div class="rounded-3xl border border-hairline-soft bg-paper p-7 sm:p-9">
      <p class="text-lg leading-relaxed text-teal-mid">{program.summary}</p>
    </div>
  </Section>

  <!-- Intro video and three screens from the app design -->
  <Section space="tight" width="wide">
    <div class="mb-10 max-w-3xl">
      <p class="eyebrow mb-5">See it</p>
      <h2 class="text-3xl sm:text-4xl">See {program.name}.</h2>
      <p class="mt-5 leading-relaxed text-teal-mid">
        Three screens from the app design: home, the main action, and what
        happens if you go off plan.
      </p>
    </div>
    <ProgramShowcase page={page} name={program.name} />
  </Section>

  <!-- What it is: the health area. Website copy awaiting clinical review. -->
  <Section space="tight" width="default">
    <div
      class="grid gap-10 rounded-3xl border border-hairline-soft bg-paper p-7 sm:p-9 md:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]"
      data-review={clinicalReviewMarker}
      id="what-it-is"
    >
      <div>
        <p class="eyebrow mb-5">{program.area}</p>
        <h2 class="text-3xl sm:text-4xl">What it is</h2>
        <div class="mt-5 space-y-4 leading-relaxed text-teal-mid">
          {page.area.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      <div>
        <h3 class="text-xl">Learn more</h3>
        <p class="mt-2 text-sm leading-relaxed text-teal-mid">
          Public health sources, on their own websites.
        </p>
        <ul class="mt-4 space-y-3">
          {
            page.learnMore.map((link) => (
              <li>
                <a
                  href={link.href}
                  rel="noopener noreferrer"
                  class="font-bold text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4 hover:decoration-coral"
                >
                  {link.label}
                </a>
                <span class="block text-sm text-teal-mid">
                  {link.publisher}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <!-- What the app helps with: features in the app's own spec -->
  <Section space="tight" width="wide">
    <div class="mb-10 max-w-3xl">
      <p class="eyebrow mb-5">In the app</p>
      <h2 class="text-3xl sm:text-4xl">What the app helps with</h2>
    </div>
    <ul class="grid gap-6 md:grid-cols-2">
      {
        page.helpsWith.map((feature) => (
          <li class="rounded-3xl border border-hairline-soft bg-paper p-7">
            <h3 class="text-xl">{feature.name}</h3>
            <p class="mt-2 leading-relaxed text-teal-mid">
              {feature.description}
            </p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- The recovery plan, step by step, as the app's recovery screen has it -->
  <Section space="tight" width="default" id="recovery-plan">
    <div class="rounded-3xl bg-teal-deep p-7 text-mint-strong sm:p-10">
      <p class="eyebrow eyebrow-on-dark mb-5">{page.recovery.screen}</p>
      <h2 class="text-3xl text-paper sm:text-4xl">
        If you go off plan: the recovery plan
      </h2>
      <p class="mt-5 text-lg leading-relaxed">
        The {page.recovery.screen.toLowerCase()} screen opens with “{
          page.recovery.heading
        }” These are its steps.
      </p>
      <ol class="mt-8 grid gap-4 md:grid-cols-2">
        {
          page.recovery.steps.map((step, index) => (
            <li class="flex gap-4 rounded-2xl bg-teal-raised p-5">
              <span
                class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-lime font-extrabold text-teal-deep"
                aria-hidden="true"
              >
                {index + 1}
              </span>
              <div>
                <h3 class="text-lg text-paper">{step.name}</h3>
                <p class="mt-1 leading-relaxed">{step.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-8 leading-relaxed">{page.recovery.note}</p>
    </div>
  </Section>

  <!-- Services: the areas the program covers -->
  <Section space="tight" width="wide">
    <div class="mb-10 max-w-3xl">
      <p class="eyebrow mb-5">What it includes</p>
      <h2 class="text-3xl sm:text-4xl">The areas {program.name} covers.</h2>
      <p class="mt-5 leading-relaxed text-teal-mid">
        Every part of {program.name} follows the same principles as the rest of Tether
        Health: private by design, no judgment, and a route to a real person.
      </p>
    </div>

    <ul class="grid gap-6 md:grid-cols-2">
      {
        program.services.map((service) => (
          <li class="rounded-3xl border border-hairline-soft bg-paper p-7">
            <span class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-mint text-teal-deep">
              <Icon name={program.icon} size={20} />
            </span>
            <h3 class="text-xl">{service.name}</h3>
            <p class="mt-2 leading-relaxed text-teal-mid">
              {service.description}
            </p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Product, where one exists -->
  {
    program.product && (
      <Section space="tight" width="default">
        <div class="rounded-3xl border-2 border-teal-deep bg-paper p-8">
          <p class="eyebrow mb-4">Featured program</p>
          <h2 class="text-3xl">{program.product.name}</h2>
          <p class="mt-4 max-w-2xl leading-relaxed text-teal-mid">
            See how {program.product.name} works, from the first check-in to the
            craving at 11pm — screen by screen.
          </p>
          <div class="mt-7">
            <Button href={program.product.href} arrow>
              Meet {program.product.name}
            </Button>
          </div>
        </div>
      </Section>
    )
  }

  <!-- The medical boundary and safety routing, on every program page -->
  <Section space="tight" width="default" id="safety">
    <div
      class="rounded-3xl border-2 border-coral/40 bg-coral-light p-7 sm:p-8"
      role="note"
    >
      <p class="text-lg font-bold leading-relaxed text-teal-deep">
        {programDisclaimer}
      </p>
      <ul class="mt-4 flex flex-wrap gap-3">
        <li>
          <a
            href="tel:911"
            class="inline-flex min-h-11 items-center rounded-full bg-paper px-5 font-bold text-teal-deep underline decoration-coral decoration-2 underline-offset-4"
            >In an emergency, call 911</a
          >
        </li>
        <li>
          <a
            href="tel:988"
            class="inline-flex min-h-11 items-center rounded-full bg-paper px-5 font-bold text-teal-deep underline decoration-coral decoration-2 underline-offset-4"
            >Thinking about harming yourself? Call or text 988</a
          >
        </li>
      </ul>
    </div>
  </Section>

  <!-- Back to the full list, and early access -->
  <Section space="tight" width="default">
    <p class="text-teal-mid">
      <a
        href="/programs/"
        class="font-bold text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4"
        >See all programs</a
      > and what each one does.
    </p>
  </Section>

  <Section tone="mint" width="default" id="waitlist">
    <div class="grid items-center gap-6 md:grid-cols-[minmax(0,1fr)_auto]">
      <div class="max-w-2xl">
        <p class="eyebrow mb-5">Early access</p>
        <h2 class="text-3xl sm:text-4xl">
          Be among the first to use {program.name}.
        </h2>
        <p class="mt-5 leading-relaxed text-teal-mid">
          Ask for early access and we will email you an invite when there is a
          place.
        </p>
      </div>
      <Button href="/beta/" arrow>Get early access</Button>
    </div>
  </Section>
</Base>
