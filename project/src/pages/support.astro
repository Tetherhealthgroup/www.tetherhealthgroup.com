---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import Icon from "../components/Icon.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import { quitlines, mailboxDirectory } from "../data/site";
import { programCount } from "../data/programs";
import SupportEmail from "../components/SupportEmail.astro";

const otherMailboxes = mailboxDirectory.filter(
  (item) => item.mailbox !== "support",
);
---

<Base
  title="Support"
  description="Help with the Tether Health app: contact, account deletion, privacy and data questions, and where to find immediate help with quitting smoking."
>
  <PageHero
    eyebrow="Support"
    title="How to reach us — and where to get help now."
    intro="Help with the Tether Health app and its programs, including BreatheFree. In a craving or a crisis, the people below can help right now; here is how to reach us about everything else."
  />

  <!-- Immediate help, first. -->
  <Section space="tight" width="wide">
    <div
      class="rounded-3xl border-2 border-coral/30 bg-coral-light p-7 sm:p-10"
    >
      <p class="eyebrow mb-4">If you need help right now</p>
      <h2 class="text-3xl">Free, confidential help is available today.</h2>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed">
        You do not need to wait for us. Trained quitline counsellors provide
        free and confidential support, and they are available now.
      </p>

      <ul class="mt-8 grid gap-5 sm:grid-cols-2">
        <li
          class="flex items-start gap-4 rounded-3xl border-2 border-coral/40 bg-paper p-6"
        >
          <span
            class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-coral text-paper"
          >
            <Icon name="alert" size={22} />
          </span>
          <span>
            <span class="eyebrow block">Medical emergency</span>
            <a
              href="tel:911"
              class="mt-1.5 flex min-h-11 items-center text-2xl font-extrabold tracking-[-0.03em] text-teal-deep underline decoration-coral decoration-2 underline-offset-4"
              >911</a
            >
            <span class="mt-1.5 block text-[0.9rem] text-teal-mid">
              Or your local emergency number
            </span>
          </span>
        </li>

        {
          quitlines.map((line) => (
            <li class="flex items-start gap-4 rounded-3xl border border-hairline-soft bg-paper p-6">
              <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-mint text-teal-deep">
                <Icon name="phone" size={22} />
              </span>
              <span>
                <span class="eyebrow block">Quitline · {line.language}</span>
                <a
                  href={`tel:${line.tel}`}
                  class="mt-1.5 flex min-h-11 items-center text-xl font-extrabold tracking-[-0.03em] text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4"
                >
                  {line.name}
                </a>
                <span class="mt-1 block text-[0.95rem] text-teal-mid">
                  {line.number}
                </span>
              </span>
            </li>
          ))
        }
      </ul>

      <p class="mt-6 text-[0.95rem] leading-relaxed text-teal-mid">
        Quitline numbers route to United States services and connect callers to
        their state's quitline. Services and hours may vary.
      </p>
    </div>
  </Section>

  <!-- Contact -->
  <Section id="contact" width="wide">
    <div class="mb-12 max-w-2xl">
      <p class="eyebrow mb-5">Contact</p>
      <h2 class="text-3xl sm:text-4xl">Write to the right inbox.</h2>
      <p class="mt-5 text-lg leading-relaxed">
        Support questions go to the support address below. For privacy,
        security, partnerships, careers, finance and general company matters
        there is a dedicated address for each.
      </p>
    </div>

    <SupportEmail
      label="Email us"
      addressClass="text-xl font-extrabold tracking-[-0.035em] text-teal-deep sm:text-2xl md:text-3xl"
      class="flex flex-col items-start gap-5 rounded-3xl border-2 border-teal-deep bg-paper p-8 shadow-[var(--shadow-card)] transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[var(--shadow-raised)] sm:flex-row sm:items-center"
    >
      <span
        class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-3xl bg-teal-deep text-lime"
      >
        <Icon name="support" size={26} />
      </span>
    </SupportEmail>

    <h3 class="mb-4 mt-12 text-xl">Other addresses</h3>
    <ul class="grid gap-4 md:grid-cols-2">
      {
        otherMailboxes.map((item) => (
          <li class="rounded-3xl border border-hairline-soft bg-paper p-6">
            <p class="font-bold text-teal-deep">{item.label}</p>
            <p class="mt-1 text-[0.95rem] leading-relaxed text-teal-mid">
              {item.use}
            </p>
            <p class="mt-3">
              <SupportEmail
                mailbox={item.mailbox}
                class="inline-block min-h-11 py-3 font-bold text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4"
              />
            </p>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      <Card icon="stethoscope" title="Clinical and research">
        Content review, evidence questions, and shaping which health area we
        build next.
      </Card>
      <Card icon="lock" title="Privacy and security">
        Data questions, privacy requests, and responsible disclosure of a
        security issue.
      </Card>
      <Card icon="accessibility" title="Accessibility">
        Barriers you hit on this site or in our products, and what would fix
        them.
      </Card>
    </div>

    <p
      class="mt-8 flex items-start gap-3 rounded-3xl border border-hairline-soft bg-paper p-6 text-[0.95rem] leading-relaxed text-teal-mid"
    >
      <Icon name="info" size={20} class="mt-0.5 shrink-0 text-teal-mid" />
      <span>
        Please do not send medical details or personal health information by
        email. Email is not a secure channel, and we are not able to give
        medical advice.
      </span>
    </p>
  </Section>

  <!-- Questions about the Tether Health app -->
  <Section id="app-help" space="tight" width="default">
    <h2 class="text-3xl sm:text-4xl">Questions about the Tether Health app</h2>
    <div class="mt-8 max-w-2xl space-y-8">
      <div>
        <h3 class="text-xl">What is Tether Health?</h3>
        <p class="mt-2 leading-relaxed text-teal-mid">
          Tether Health is one app with {programCount} programs, one for each area
          of health. BreatheFree, for tobacco and nicotine, is one of them. See
          <a
            href="/programs/"
            class="font-bold text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4"
            >all {programCount} programs</a
          > and where each one stands.
        </p>
      </div>
      <div>
        <h3 class="text-xl">How do I get help with the app?</h3>
        <p class="mt-2 leading-relaxed text-teal-mid">
          Email <SupportEmail
            class="font-bold text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4"
          />. It helps to include the app version, shown at the bottom of
          Account. Please do not include medical details.
        </p>
      </div>
      <div>
        <h3 class="text-xl">I forgot my password.</h3>
        <p class="mt-2 leading-relaxed text-teal-mid">
          On the sign-in screen, tap "Forgot password?" and enter your email
          address. If an account exists for that address, a reset link is sent
          to it. If you signed in with Apple or Google, tap "Continue with
          Apple" or "Continue with Google" instead.
        </p>
      </div>
      <div id="export">
        <h3 class="text-xl">How do I get a copy of my data?</h3>
        <p class="mt-2 leading-relaxed text-teal-mid">
          In the app, open Account, then "Your data", and choose an export.
        </p>
      </div>
      <div id="delete">
        <h3 class="text-xl">How do I delete my account and data?</h3>
        <p class="mt-2 leading-relaxed text-teal-mid">
          In the app, open Account, then "Your data", then "Delete account and
          all data". The full steps, including what to do if you cannot sign in,
          are on the <a
            href="/delete-account/"
            class="font-bold text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4"
            >account deletion page</a
          >.
        </p>
      </div>
      <div>
        <h3 class="text-xl">How is my information handled?</h3>
        {/* Revisit when ads ship (P-107). */}
        <p class="mt-2 leading-relaxed text-teal-mid">
          No ads, and we never sell your health data. The details are in the <a
            href="/app-privacy/"
            class="font-bold text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4"
            >Tether Health app privacy policy</a
          >.
        </p>
      </div>
      <div>
        <h3 class="text-xl">Is the app medical advice?</h3>
        <p class="mt-2 leading-relaxed text-teal-mid">
          No. The app does not diagnose, treat or prescribe, and it does not
          replace your clinician. If you need help right now, use the numbers at
          the top of this page.
        </p>
      </div>
    </div>
  </Section>

  <!-- Questions about BreatheFree -->
  <Section space="tight" width="default">
    <h2 class="text-3xl sm:text-4xl">Questions about BreatheFree</h2>
    <div class="mt-8 max-w-2xl space-y-8">
      <div>
        <h3 class="text-xl">How do I get BreatheFree?</h3>
        <p class="mt-2 leading-relaxed text-teal-mid">
          BreatheFree opens to early-access members first, on Android. Request
          early access with the form below and we will write to you as places
          become available.
        </p>
      </div>
      <div id="testing-list">
        <h3 class="text-xl">How do I join the testing list?</h3>
        <p class="mt-2 leading-relaxed text-teal-mid">
          {/* needs-counsel: P-108 */}
          <a
            href="/beta/"
            class="font-bold text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4"
            >Get early access</a
          >. Tell us which phone you use and we will email you an invite when
          there is a spot. We cannot promise a date, and joining does not
          guarantee a place.
        </p>
      </div>
      <div>
        <h3 class="text-xl">
          What about other platforms and the other health areas?
        </h3>
        <p class="mt-2 leading-relaxed text-teal-mid">
          Android comes first. When you request early access, tell us which of
          the {programCount} programs matters most to you.
        </p>
      </div>
    </div>
  </Section>

  <!-- Early access -->
  <Section tone="mint" width="default" id="waitlist">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow mb-5">Early access</p>
      <h2 id="waitlist-heading" class="text-3xl sm:text-4xl">
        Be among the first to use BreatheFree.
      </h2>
      <p class="mt-5 text-lg leading-relaxed">
        Request early access and we will write to you as places open up on
        Android. Want to help test the app? <a
          href="/beta/"
          class="font-bold text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4"
          >Get early access</a
        > instead.
      </p>
    </div>

    <div
      class="mx-auto mt-10 max-w-3xl rounded-3xl border border-hairline-soft bg-paper p-7 shadow-[var(--shadow-card)] sm:p-10"
    >
      <WaitlistForm />
    </div>
  </Section>
</Base>
