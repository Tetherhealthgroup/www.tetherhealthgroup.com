---
/**
 * Account deletion for the Tether Health app (WEB-009, draft).
 *
 * The public web resource Play asks for (R-054): how to delete an account,
 * including without the app, naming the app and developer, and what is
 * deleted and kept. Content comes from docs/PLAY_CONSOLE_ANSWERS.md sections
 * F and A.6 (Tether-Health, office/TH-093-play-listing at 44c5510); each
 * sentence carries a comment naming its source line or its needs-owner /
 * needs-counsel label.
 *
 * Not published: noindex, linked from nowhere, and filtered out of the
 * sitemap in astro.config.mjs. The owner removes noindex, adds links and
 * drops the sitemap filter only after counsel signs off (Tier 4).
 */

import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import Icon from "../components/Icon.astro";
import SupportEmail from "../components/SupportEmail.astro";
import { site } from "../data/site";

const appName = "Tether Health";
const emailSubject = `Delete my ${appName} account`;

/* The in-app path, in order: PLAY_CONSOLE_ANSWERS F:449-453. Rendered with
   the numbered-step pattern from breathefree/how-it-works.astro so the page
   adds no utility class the shared stylesheet does not already contain. */
const inAppSteps = [
  `Open the ${appName} app and sign in.`,
  "Go to Home.",
  "Tap your profile avatar at the top right.",
  'Tap "Settings & privacy".',
  'Scroll to "Your data".',
  'Tap "Delete account and data".',
  "Enter your current password and type DELETE to confirm.",
];
---

<Base
  title={`Delete your ${appName} account`}
  description={`How to delete your ${appName} account and data, in the app or by email if you cannot sign in, and what is deleted and kept.`}
  noindex
>
  <PageHero
    eyebrow="Account deletion"
    title={`Delete your ${appName} account`}
    intro={`How to delete your account and data in the ${appName} app, developed by ${site.legalName}, including if you cannot sign in.`}
    width="narrow"
  />
  <!-- intro: PLAY_CONSOLE_ANSWERS F:429 (app and developer names), F:419-421 (Play asks for a no-reinstall route) -->

  <Section width="narrow">
    <p
      class="mb-12 flex items-start gap-3 rounded-3xl border border-mint-strong bg-mint p-6 leading-relaxed text-teal-mid"
    >
      <Icon name="info" size={20} class="mt-0.5 shrink-0 text-teal-deep" />
      <span>
        <!-- draft notice: WEB-009 ticket; F:426-427 (owner and counsel to finalize, not published) -->
        Draft for review by {site.legalName} and its counsel. Items marked "To be
        confirmed" are not decided yet.
      </span>
    </p>

    <div class="prose-tether">
      <h2>Delete your account in the app</h2>
      <!-- steps: F:449-454 (in-app path, Observed in app code) -->
      <ol id="in-app-steps" class="grid gap-3">
        {
          inAppSteps.map((step, index) => (
            <li class="flex items-start gap-4 rounded-3xl border border-hairline-soft bg-paper/80 p-5">
              <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-mint-pale text-[0.85rem] font-extrabold text-teal-mid">
                {index + 1}
              </span>
              <span>{step}</span>
            </li>
          ))
        }
      </ol>
      <!-- F:453-454 -->
      <p>If you are signed out, the same option first asks you to sign in.</p>

      <h2>If you cannot sign in</h2>
      <!-- A.6:311-312 (a reset is implied there; the reset flow itself is not cited: needs-owner to confirm it exists) -->
      <p>
        If you have forgotten your password, reset it first and then follow the
        steps above.
      </p>
      <!-- F:430-432 (mailbox published at src/data/site.ts contact.support) -->
      <p>
        Or email <SupportEmail subject={emailSubject} /> from the email address on
        your account, with the subject "{emailSubject}".
      </p>
      <!-- needs-owner: F:432-433 (whether a manual mailbox process exists and who runs it: Unknown) -->
      <p>
        To be confirmed: who handles these requests, and how we check that a
        request comes from the account holder.
      </p>
      <!-- needs-owner, needs-counsel: no timeline in F or A.6 -->
      <p>To be confirmed: how long it takes to complete a request.</p>

      <h2>What is deleted</h2>
      <!-- F:434-435; matches A.6:278-285 (server-side, Observed in code; live run NOT RUN, A.6:307) -->
      <p>Deleting a signed-in account deletes:</p>
      <ul>
        <li>your profile and display name</li>
        <li>your quit plan</li>
        <li>your program health data</li>
        <li>your profile photo</li>
        <li>your sign-in account</li>
      </ul>

      <h2>What is kept</h2>
      <!-- F:435-436; A.6:309-310 -->
      <p>
        Copies in backups and logs are kept until those backups and logs expire.
      </p>
      <!-- needs-counsel: F:436, A.6:310 (retention period Unknown) -->
      <p>To be confirmed: how long backups and logs are kept.</p>
      <!-- A.6:309 ("any copy the user exported" is not covered); needs-counsel; whether the app offers an export is not stated in F or A.6 -->
      <p>
        Deleting your account does not delete any copy you made outside the app
        yourself.
      </p>

      <h2>Data on your device</h2>
      <!-- F:437 -->
      <p>
        If you use the app as a guest, without signing in, your data is stored
        only on your device.
      </p>
      <!-- F:437-441; A.6:286-296 -->
      <p>
        Deleting a signed-in account also clears the guest quit plan on that
        device, but not Heartwise, Steady or ClearAir entries made as a guest.
      </p>
      <!-- F:441-442; A.6:313-314 -->
      <p>"Remove device plan" in Settings removes only the guest quit plan.</p>
      <!-- F:442-443; A.6:314-316 -->
      <p>
        There is no in-app way for a guest to remove Heartwise or ClearAir
        entries, and Steady readings can only be removed one at a time.
      </p>
      <!-- F:443-445; A.6:317-318 -->
      <p>
        To remove all guest data, uninstall the app, or on Android go to
        Settings &gt; Apps &gt; {appName} &gt; Storage &gt; Clear storage.
      </p>
      <!-- F:446-447; A.6:319-321 -->
      <p>
        Signing out does not remove your account's program data from the device.
        To remove it, delete the account, uninstall the app or clear its
        storage.
      </p>
    </div>
  </Section>
</Base>
