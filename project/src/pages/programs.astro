---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import ProgramCard from "../components/ProgramCard.astro";
import {
  programs,
  programCount,
  programsWithStatus,
  statusLabels,
  statusMeanings,
  statusOrder,
} from "../data/programs";
---

<Base
  title="Programs"
  description={`The ${programCount} programs of the Tether Health app, one per area of health, and where each one stands today. BreatheFree is in build; none is available to use yet.`}
>
  <PageHero
    eyebrow="Where we are headed"
    title={`${programCount} programs, one app, one area at a time.`}
    intro="Tether Health is one app with a program for each area of health. Behaviour change looks different across conditions, but the machinery underneath is shared. We are building that machinery once, then shaping it to each program — starting with BreatheFree, for tobacco and nicotine."
  />

  <!-- Status key: the app's own status words -->
  <Section space="tight" width="wide">
    <ul class="grid gap-5 sm:grid-cols-2">
      {
        statusOrder.map((status) => (
          <li
            class:list={[
              "flex items-start gap-4 rounded-3xl border bg-paper p-6",
              status === "in-build"
                ? "border-teal-deep/25 ring-1 ring-teal-deep/10"
                : "border-hairline-soft",
            ]}
          >
            <span
              class:list={[
                "inline-flex items-center gap-1.5 whitespace-nowrap rounded-full px-3 py-1.5 text-[0.7rem] font-extrabold uppercase tracking-[0.12em]",
                status === "in-build"
                  ? "bg-lime text-teal-deep"
                  : "bg-mint-pale text-teal-mid ring-1 ring-hairline-soft",
              ]}
            >
              {status === "in-build" && (
                <span class="relative flex h-2 w-2" aria-hidden="true">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal-deep opacity-60" />
                  <span class="relative inline-flex h-2 w-2 rounded-full bg-teal-deep" />
                </span>
              )}
              {statusLabels[status]}
            </span>
            {/* needs-counsel: WEB-005 */}
            <p class="text-[0.95rem] leading-relaxed text-teal-mid">
              {statusMeanings[status]} {programsWithStatus(status).length} of{" "}
              {programCount} programs.
            </p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- The areas -->
  <Section space="tight" width="wide">
    {
      /*
      The card headings are h3, matching the h2-section / h3-card pattern used
      everywhere else. On the home page an h2 introduces this same grid; here
      that sentence is the page h1, which left the outline jumping h1 -> h3.
      The heading is screen-reader-only because the hero already says this in
      view — the outline needs the level, the page does not need the words.
    */
    }
    <h2 class="sr-only">All {programCount} programs</h2>
    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        programs.map((program) => (
          <li>
            <ProgramCard program={program} />
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- How we choose -->
  <Section tone="deep" width="default">
    <div class="max-w-3xl">
      <p class="eyebrow eyebrow-on-dark mb-5">How we choose what is next</p>
      <h2 class="text-4xl text-paper">
        Need, evidence, and whether we can do it honestly.
      </h2>
      <div class="mt-8 grid gap-5">
        {
          [
            {
              title: "Where the burden is largest",
              body: "We start where the number of people affected and the severity of outcomes are both high, and where self-management genuinely changes the picture.",
            },
            {
              title: "Where the evidence is settled",
              body: "We build on established clinical guidance, not on a promising study. If the evidence for an intervention is thin, a nicely designed app does not fix that.",
            },
            {
              title: "Where software is the right tool",
              body: "Some problems need a clinician, a prescription or a policy, not a phone. We would rather route someone to the right help than pretend an app is it.",
            },
          ].map((item) => (
            <div class="rounded-3xl bg-white/5 p-6 ring-1 ring-white/10">
              <h3 class="text-lg text-paper">{item.title}</h3>
              <p class="mt-2 leading-relaxed text-mint-strong/85">
                {item.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- CTA -->
  <Section width="default">
    <div
      class="rounded-3xl border border-hairline-soft bg-paper p-8 shadow-[var(--shadow-card)] sm:p-12"
    >
      <div class="grid items-center gap-8 md:grid-cols-[1fr_auto]">
        <div>
          <h2 class="text-3xl">Is your area on this list?</h2>
          <p class="mt-4 text-lg leading-relaxed">
            If you work in one of these areas — clinically, in research, or in
            public health — the order we build in should be informed by you.
          </p>
          <p
            class="mt-5 flex items-start gap-3 text-[0.95rem] leading-relaxed text-teal-mid"
          >
            <Icon name="info" size={19} class="mt-0.5 shrink-0" />
            <span>
              Programs that are not in build describe intent. Nothing listed
              here is available for clinical use today.
            </span>
          </p>
        </div>
        <Button href="/#waitlist" arrow>Get in touch</Button>
      </div>
    </div>
  </Section>
</Base>
