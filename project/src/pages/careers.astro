---
/**
 * Careers: four open roles, who we look for, and how to apply.
 *
 * The roles and their one-line descriptions are the owner's (2026-10-28); the
 * bullets restate those words and add nothing. No pay, equity, benefits,
 * location, seniority, start date, team size or employment type is published,
 * except "part-time" for the clinical advisor, which the owner chose. No
 * JobPosting structured data: Google requires a job location or applicant
 * location requirements, and none has been supplied.
 */

import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import SupportEmail from "../components/SupportEmail.astro";
import { site } from "../data/site";
import { programCount } from "../data/programs";

const values = [
  {
    icon: "users" as const,
    title: "People before metrics",
    body: "We measure ourselves by whether a tool helps someone on a hard day, not by how often it makes them open an app.",
  },
  {
    icon: "lock" as const,
    title: "Privacy is the product",
    body: "No ads and no selling health data. Privacy and security shape what we build from the first sketch, not at the end.",
  },
  {
    icon: "stethoscope" as const,
    title: "Clinical judgment, built in",
    body: "We want a clinician's judgment shaping the safety rules, the content and the routes to real people in every program. That is why a clinical advisor role is among our first openings.",
  },
  {
    icon: "accessibility" as const,
    title: "Built for everyone",
    body: "Plain language, careful design and accessibility treated as part of the work, not a checklist after it.",
  },
];

const positions = [
  {
    id: "mobile-engineer",
    title: "Mobile engineer (Flutter)",
    summary: "iOS and Android app, design system, accessibility.",
    work: [
      "Build and maintain the Tether Health app for iOS and Android in Flutter.",
      "Develop the app's design system.",
      "Make accessibility part of every screen.",
    ],
  },
  {
    id: "backend-engineer",
    title: "Backend engineer",
    summary: "Node.js/NestJS API, PostgreSQL/Supabase, security and privacy.",
    work: [
      "Build and maintain the app's Node.js/NestJS API.",
      "Design and evolve the data in PostgreSQL and Supabase.",
      "Treat security and privacy as part of every change.",
    ],
  },
  {
    id: "clinical-advisor",
    title: "Clinical advisor (part-time)",
    summary:
      "A clinician reviewing safety rules, programme content and sign-offs.",
    work: [
      "Review the app's safety rules.",
      "Review programme content.",
      "Give clinical sign-offs.",
    ],
  },
  {
    id: "growth-community",
    title: "Growth & community",
    summary: "Beta testers, partnerships with clinics and employers, content.",
    work: [
      "Recruit and support beta testers.",
      "Build partnerships with clinics and employers.",
      "Plan and create content.",
    ],
  },
];

const disciplines = [
  {
    icon: "phone" as const,
    title: "Engineering",
    body: "Mobile, backend and health-data engineers who care about reliability, privacy and the standards that let records move safely — FHIR and SMART on FHIR among them.",
  },
  {
    icon: "spark" as const,
    title: "Design and research",
    body: "Product designers, content designers and researchers who can make a difficult moment feel calmer with fewer words.",
  },
  {
    icon: "stethoscope" as const,
    title: "Clinical and behavioural science",
    body: "Clinicians, pharmacists and behavioural scientists who want to shape support for tobacco, heart health, diabetes, healthy aging and more.",
  },
  {
    icon: "shield" as const,
    title: "Privacy, security and compliance",
    body: "Specialists in HIPAA, health-data security and digital health regulation who want to build it right from the start.",
  },
  {
    icon: "support" as const,
    title: "Partnerships and operations",
    body: "People who can bring health systems, payers, employers and public-health organisations alongside us.",
  },
];
---

<Base
  title="Careers"
  description={`Work at ${site.name}: calm, private digital health tools across ${programCount} areas of health. Engineering, design, clinical, privacy and partnerships.`}
>
  <PageHero
    eyebrow="Careers"
    title="Help build care that meets people where they are."
    intro={`Tether Health is one app with ${programCount} programs, from quitting smoking to heart health and healthy aging. We are looking for people who want health technology to be calmer, kinder and more private.`}
  />

  <Section width="wide">
    <div class="mb-12 max-w-3xl">
      <p class="eyebrow mb-5">How we work</p>
      <h2 class="text-4xl sm:text-5xl">Four things we hold to.</h2>
    </div>
    <ul class="grid gap-6 md:grid-cols-2">
      {
        values.map((value) => (
          <li>
            <Card icon={value.icon} title={value.title}>
              {value.body}
            </Card>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section width="wide" id="open-roles">
    <div class="mb-12 max-w-3xl">
      <p class="eyebrow mb-5">Open roles</p>
      <h2 class="text-4xl sm:text-5xl">Four roles we are hiring for.</h2>
    </div>
    <ul class="grid gap-6 md:grid-cols-2">
      {
        positions.map((role) => (
          <li
            id={role.id}
            class="rounded-3xl border border-hairline-soft bg-paper p-7 shadow-[var(--shadow-card)]"
          >
            <h3 class="text-2xl">{role.title}</h3>
            <p class="mt-3 text-lg leading-relaxed">{role.summary}</p>
            <ul class="mt-4 list-disc space-y-1.5 pl-5 leading-relaxed text-teal-mid">
              {role.work.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <p class="mt-5 leading-relaxed">
              <strong>How to apply:</strong> email{" "}
              <SupportEmail
                mailbox="careers"
                subject={role.title}
                class="font-bold text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4"
              />{" "}
              with the role in the subject.
            </p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="deep" width="wide">
    <div class="mb-12 max-w-3xl">
      <p class="eyebrow eyebrow-on-dark mb-5">Who we look for</p>
      <h2 class="text-4xl text-paper sm:text-5xl">
        The people who make Tether Health.
      </h2>
    </div>
    <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        disciplines.map((item) => (
          <li>
            <Card icon={item.icon} title={item.title} tone="deep">
              {item.body}
            </Card>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section width="default">
    <div
      class="rounded-3xl border border-hairline-soft bg-paper p-8 shadow-[var(--shadow-card)] sm:p-12"
    >
      <h2 class="text-3xl sm:text-4xl">Want to work with us?</h2>
      <p class="mt-5 text-lg leading-relaxed">
        Send your résumé or a link to your work, with a few lines about what you
        would bring and which area of health matters to you, to <SupportEmail
          mailbox="careers"
          subject="Careers enquiry"
          class="font-bold text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4"
        />.
      </p>
      <p class="mt-5 leading-relaxed text-teal-mid">
        We welcome applicants of every background, identity and ability. If you
        need an adjustment to take part in our hiring process, tell us in your
        first message.
      </p>
      {/* needs-counsel: WEB-913, equal-opportunity statement. */}
      <p class="mt-3 leading-relaxed text-teal-mid">
        Tether Health is an equal opportunity employer.
      </p>
      <p class="mt-3 leading-relaxed text-teal-mid">
        What happens to what you send us is in the <a
          href="/privacy/#job-applications"
          class="font-bold text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4"
          >privacy notice</a
        >.
      </p>
    </div>
  </Section>
</Base>
