---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import Icon from "../components/Icon.astro";
import ProgramCard from "../components/ProgramCard.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import BetaCta from "../components/BetaCta.astro";
import { site } from "../data/site";
import { programs, programCount } from "../data/programs";
import SupportEmail from "../components/SupportEmail.astro";

/* Sources for record import, all coming in the app (see data/integrations.ts). */
const recordSources = [
  {
    icon: "stethoscope" as const,
    title: "Epic MyChart",
    body: "Bring in records from a health system that uses Epic, through your own MyChart sign-in. Coming in the app.",
  },
  {
    icon: "shield" as const,
    title: "Medicare Blue Button",
    body: "People with Medicare will be able to bring in their claims history by signing in with Medicare. Coming in the app.",
  },
  {
    icon: "phone" as const,
    title: "Apple Health",
    body: "Import the records you keep in Apple Health, after your phone asks your permission. Coming in the app.",
  },
  {
    icon: "phone" as const,
    title: "Health Connect",
    body: "Import the records you keep in Android's Health Connect, after your phone asks your permission. Coming in the app.",
  },
];

/* What the app does with the people who care for you (WEB-914). */
const doctorFeatures = [
  {
    icon: "check" as const,
    title: "A visit summary you preview first",
    body: "Share a summary of what you have tracked before an appointment. You see exactly what it contains before it goes anywhere.",
  },
  {
    icon: "users" as const,
    title: "Connect a clinic with an invite code",
    body: "If your clinic gives you an invite code, you can connect to it from the app. Nothing is shared until you choose to.",
  },
  {
    icon: "lock" as const,
    title: "Read-only links you control",
    body: "Share a read-only view through a single-use link that expires, and stop sharing at any time.",
  },
  {
    icon: "alert" as const,
    title: "Safety help, one tap away",
    body: "Emergency and crisis help, 911 and 988, is always one tap away in the app.",
  },
];

const principles = [
  {
    icon: "lock" as const,
    title: "Private by design",
    // Revisit when ads ship (P-107).
    body: "No ads. No selling health data. Sensitive notification text is off by default, so a lock screen never announces someone's health to the room.",
  },
  {
    icon: "users" as const,
    title: "No judgment, just support",
    body: "A setback never erases progress. Our tools are built to respond to a difficult day with help rather than a broken streak.",
  },
  {
    icon: "clock" as const,
    title: "Works when it is needed",
    body: "The hardest moments do not wait, so core support tools are designed to work one-handed.",
  },
  {
    icon: "accessibility" as const,
    title: "Designed to be usable",
    body: "Designed for plain language, screen readers, larger text, and a choice of English or Spanish.",
  },
];
---

<Base
  title="Tether Health Group — care that meets people where they are"
  description={site.description}
  bareTitle
>
  <!-- ===================================================================
       Hero
  ==================================================================== -->
  <Section width="wide" space="loose" class="relative overflow-hidden">
    <!-- Calm breathing rings, echoing the app's welcome illustration. -->
    <div
      class="pointer-events-none absolute right-[-14rem] top-[-8rem] hidden h-[42rem] w-[42rem] lg:block"
      aria-hidden="true"
    >
      <div
        class="animate-breathe absolute inset-0 rounded-full bg-mint-strong/25 blur-3xl"
      >
      </div>
      <div
        class="absolute inset-[12%] rounded-full border border-mint-strong/40"
      >
      </div>
      <div
        class="absolute inset-[24%] rounded-full border border-dashed border-mint-strong/50"
      >
      </div>
    </div>

    <div class="relative grid items-center gap-16 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="animate-rise">
        <p
          class="mb-7 inline-flex items-center gap-2.5 rounded-full border border-mint-strong bg-mint px-4 py-2 text-[0.78rem] font-extrabold uppercase tracking-[0.16em] text-teal-deep"
        >
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-coral opacity-70"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-coral"
            ></span>
          </span>
          One app · {programCount} programs
        </p>

        <h1 class="text-[2.75rem] sm:text-[3.75rem] lg:text-[4.25rem]">
          Care that meets people where they are.
        </h1>

        <p class="mt-7 max-w-xl text-xl leading-relaxed">
          Tether Health Group makes calm, private digital health tools — one app
          with a program for each of {programCount} areas of health, starting with
          quitting smoking. Small steps, practical support, and no judgment.
        </p>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
          <Button href="/beta/" arrow>Get early access</Button>
          <Button href="/programs/" variant="secondary">
            See all {programCount} programs
          </Button>
        </div>

        <p class="mt-7 flex items-center gap-2.5 text-[0.95rem] text-teal-mid">
          <Icon name="shield" size={18} class="text-teal-mid" />
          {/* needs-counsel: P-108 */}
          No trackers on this site. Early access asks for your first name, email,
          phone type and, if you choose, how you heard about us.
        </p>
      </div>

      <div class="flex justify-center lg:justify-end">
        {
          /* The eleven programs as their app letters and colours; decorative. */
        }
        <ul class="grid grid-cols-4 gap-3 sm:gap-4" aria-hidden="true">
          {
            programs.map((program) => (
              <li
                class="inline-flex h-16 w-16 items-center justify-center rounded-3xl text-2xl font-extrabold text-paper shadow-[var(--shadow-card)] sm:h-20 sm:w-20"
                style={`background-color: ${program.color}`}
              >
                {program.letter}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <!-- Beta waitlist -->
  <BetaCta />

  <!-- ===================================================================
       What we are building
  ==================================================================== -->
  <Section tone="deep" width="wide">
    <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="eyebrow eyebrow-on-dark mb-5">What we make</p>
        <h2 class="text-4xl text-paper sm:text-5xl">
          One system. Many areas of health.
        </h2>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-mint-strong">
          The hard parts of behaviour change are the same whether someone is
          quitting cigarettes, managing blood glucose or keeping up with a
          screening schedule: a plan you actually believe in, help in the moment
          it is needed, and a record that survives a bad week.
        </p>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-mint-strong">
          Tether Health brings that together once — consent, plain-language
          education, coping tools, progress without punishment, and routes to
          real people — and shapes it to each health area.
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        {
          [
            {
              icon: "check" as const,
              title: "A plan people own",
              body: "Built from someone's own reasons, their own date, their own supporter.",
            },
            {
              icon: "wave" as const,
              title: "Help in the moment",
              body: "Short, guided tools for the minutes that decide the outcome.",
            },
            {
              icon: "progress" as const,
              title: "Progress without punishment",
              body: "Patterns and estimates that a setback never wipes out.",
            },
            {
              icon: "support" as const,
              title: "A route to a person",
              body: "Quitlines, supporters, coaches and care teams — never a dead end.",
            },
          ].map((item) => (
            <div class="rounded-3xl bg-white/5 p-6 ring-1 ring-white/10">
              <span class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-teal-raised text-lime">
                <Icon name={item.icon} size={21} />
              </span>
              <h3 class="text-lg text-paper">{item.title}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-mint-strong/85">
                {item.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- ===================================================================
       Health areas
  ==================================================================== -->
  <Section id="programs" width="wide">
    <div class="mb-14 max-w-3xl">
      <p class="eyebrow mb-5">The programs</p>
      <h2 class="text-4xl sm:text-5xl">
        {programCount} programs. One app.
      </h2>
      <p class="mt-6 text-lg leading-relaxed">
        Behaviour change looks different across conditions, but what helps is
        shared. Each program brings the same calm, private toolkit to its own
        area of health, and early access covers the app's programs on iPhone and
        Android.
      </p>
    </div>

    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        programs.map((program) => (
          <li>
            <ProgramCard program={program} single />
          </li>
        ))
      }
    </ul>

    <p
      class="mt-10 flex items-start gap-3 rounded-3xl border border-hairline-soft bg-paper p-6 text-[0.95rem] leading-relaxed text-teal-mid"
    >
      <Icon name="info" size={20} class="mt-0.5 shrink-0 text-teal-mid" />
      <span>
        Tether Health programs educate and support self-management. No Tether
        Health Group product diagnoses, treats or prescribes, and none replaces
        your clinician.
      </span>
    </p>
  </Section>

  <!-- ===================================================================
       Principles
  ==================================================================== -->
  <Section width="wide">
    <div class="mb-14 max-w-3xl">
      <p class="eyebrow mb-5">How we build</p>
      <h2 class="text-4xl sm:text-5xl">
        Four commitments we will not trade away.
      </h2>
    </div>

    <ul class="grid gap-6 md:grid-cols-2">
      {
        principles.map((principle) => (
          <li>
            <Card icon={principle.icon} title={principle.title}>
              {principle.body}
            </Card>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- ===================================================================
       Bring your health records
  ==================================================================== -->
  <Section tone="deep" width="wide" id="records">
    <div class="grid items-center gap-14 lg:grid-cols-[1fr_1fr]">
      <div>
        <p class="eyebrow eyebrow-on-dark mb-5">Coming in the app</p>
        <h2 class="text-4xl text-paper sm:text-5xl">
          Bring your health records.
        </h2>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-mint-strong">
          Importing your records is coming in the app. It is not available
          today. When it arrives it is opt-in only: you choose a source, review
          every item before it is added, and can disconnect at any time. It will
          use HL7® FHIR® and SMART on FHIR, the open standards US health records
          use.
        </p>
        <div class="mt-9">
          <Button href="/integrations/" arrow>How import will work</Button>
        </div>
      </div>
      <ul class="grid gap-5 sm:grid-cols-2">
        {
          recordSources.map((item) => (
            <li class="rounded-3xl bg-white/5 p-6 ring-1 ring-white/10">
              <span class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-teal-raised text-lime">
                <Icon name={item.icon} size={21} />
              </span>
              <h3 class="text-lg text-paper">{item.title}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-mint-strong/85">
                {item.body}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="mt-12 text-sm leading-relaxed text-mint-strong/85">
      Epic and MyChart are trademarks of Epic Systems Corporation. Blue Button®
      is a registered mark of the U.S. Department of Health and Human Services.
      Apple Health is a trademark of Apple Inc. Health Connect is a trademark of
      Google LLC. Naming them does not imply endorsement by, or partnership
      with, any of their owners.
    </p>
  </Section>

  <!-- ===================================================================
       Work with your doctor
  ==================================================================== -->
  <Section tone="paper" width="wide" id="doctor">
    <div class="mb-12 max-w-3xl">
      <p class="eyebrow mb-5">Work with your doctor</p>
      <h2 class="text-4xl sm:text-5xl">
        Designed to support the care you already have.
      </h2>
      <p class="mt-6 text-lg leading-relaxed">
        Tether Health does not diagnose, treat or prescribe, and it does not
        replace your clinician. It helps you bring what you track to the people
        who care for you, on your terms.
      </p>
    </div>
    <ul class="grid gap-6 md:grid-cols-2">
      {
        doctorFeatures.map((item) => (
          <li>
            <Card icon={item.icon} title={item.title}>
              {item.body}
            </Card>
          </li>
        ))
      }
    </ul>
    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <Button href="/for-clinicians/" arrow>For clinicians</Button>
      <Button href="/security/" variant="secondary">
        Our privacy and security posture
      </Button>
    </div>
  </Section>

  <!-- ===================================================================
       Help and support
  ==================================================================== -->
  <Section width="default" space="tight" id="help">
    <div
      class="grid gap-8 rounded-3xl border border-hairline-soft bg-paper p-8 shadow-[var(--shadow-card)] sm:p-10 md:grid-cols-2"
    >
      <div>
        <h2 class="text-2xl sm:text-3xl">Need help?</h2>
        <p class="mt-4 leading-relaxed">
          Email <SupportEmail
            class="font-bold text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4"
          /> or visit our <a
            href="/support/"
            class="font-bold text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4"
            >support page</a
          >. Email is not monitored around the clock and we cannot give medical
          advice.
        </p>
      </div>
      <div
        class="rounded-2xl border-2 border-coral/30 bg-coral-light p-6 text-teal-deep"
      >
        <h2 class="text-2xl">In an emergency</h2>
        <p class="mt-4 leading-relaxed">
          Call <a
            href="tel:911"
            class="inline-flex min-h-11 items-center font-bold underline decoration-coral decoration-2 underline-offset-4"
            >911</a
          >
          or your local emergency number. In a mental-health crisis, call or text
          <a
            href="tel:988"
            class="inline-flex min-h-11 items-center font-bold underline decoration-coral decoration-2 underline-offset-4"
            >988</a
          >, the Suicide &amp; Crisis Lifeline.
        </p>
      </div>
    </div>
  </Section>

  <!-- ===================================================================
       Waitlist
  ==================================================================== -->
  <Section id="waitlist" tone="mint" width="default">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow mb-5">Early access</p>
      <h2 id="waitlist-heading" class="text-4xl sm:text-5xl">
        Be among the first to use Tether Health.
      </h2>
      <p class="mt-6 text-lg leading-relaxed">
        Request early access and we will write to you as places open up. Early
        access covers the app's programs on iPhone and Android. Tell us who you
        are and what would make this genuinely useful. Want to help test the
        app? <a
          href="/beta/"
          class="font-bold text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4"
          >Get early access</a
        > and we will email you an invite when there is a spot.
      </p>
    </div>

    <div
      class="mx-auto mt-12 max-w-3xl rounded-3xl border border-hairline-soft bg-paper p-7 shadow-[var(--shadow-card)] sm:p-10"
    >
      <WaitlistForm />
    </div>
  </Section>
</Base>
