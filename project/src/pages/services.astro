---
/**
 * Every service line across every health area, in one place.
 *
 * Present tense describes what each program does. No program is released, so
 * the call to action is early access and nothing here invites a download.
 */

import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import Icon from "../components/Icon.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import { programs, programCount } from "../data/programs";

const serviceCount = programs.reduce((n, p) => n + p.services.length, 0);
---

<Base
  title="Services"
  description={`All ${serviceCount} services across the ${programCount} programs of the Tether Health app, from craving rescue and relapse prevention to screening reminders and care-team coordination.`}
>
  <PageHero
    eyebrow="Services"
    title="Everything Tether Health does, in one place."
    intro={`What each program covers, gathered from all ${programCount}. One app, one set of principles, shaped to each area of health.`}
  />

  <Section space="tight" width="default">
    <div
      class="flex flex-col gap-5 rounded-3xl border border-hairline-soft bg-paper p-7 sm:flex-row sm:items-center sm:gap-8"
    >
      <span
        class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-mint text-teal-deep"
      >
        <Icon name="info" size={22} />
      </span>
      <p class="leading-relaxed text-teal-mid">
        <strong class="font-bold text-teal-deep"
          >{serviceCount} services across {programCount} programs.</strong
        > Every one educates and supports self-management. None diagnoses, treats
        or prescribes, and none replaces your clinician.
      </p>
    </div>
  </Section>

  {
    programs.map((program) => (
      <Section space="tight" width="wide">
        <div class="mb-8 flex flex-wrap items-center gap-4">
          <span
            class="inline-flex h-12 w-12 items-center justify-center rounded-2xl text-xl font-extrabold text-paper"
            style={`background-color: ${program.color}`}
            aria-hidden="true"
          >
            {program.letter}
          </span>
          <h2 class="text-2xl sm:text-3xl">
            <a
              href={`/programs/${program.id}/`}
              class="underline decoration-mint-strong decoration-2 underline-offset-4 transition-colors hover:decoration-coral"
            >
              {program.name}
            </a>
            <span class="block text-base font-bold text-teal-mid">
              {program.area}
            </span>
          </h2>
          <span class="rounded-full bg-mint-pale px-3 py-1.5 text-[0.7rem] font-extrabold uppercase tracking-[0.12em] text-teal-mid ring-1 ring-hairline-soft">
            {program.archetype}
          </span>
        </div>

        <ul class="grid gap-5 md:grid-cols-2">
          {program.services.map((service) => (
            <li class="rounded-3xl border border-hairline-soft bg-paper p-6">
              <h3 class="text-lg">{service.name}</h3>
              <p class="mt-2 leading-relaxed text-teal-mid">
                {service.description}
              </p>
            </li>
          ))}
        </ul>
      </Section>
    ))
  }

  <Section tone="mint" width="default" id="waitlist">
    <div class="mb-10 max-w-2xl">
      <p class="eyebrow mb-5">Early access</p>
      <h2 class="text-3xl sm:text-4xl">Which of these matters to you?</h2>
      <p class="mt-5 leading-relaxed text-teal-mid">
        Request early access and tell us the area. We will write to you as
        places become available.
      </p>
    </div>
    <WaitlistForm />
  </Section>
</Base>
