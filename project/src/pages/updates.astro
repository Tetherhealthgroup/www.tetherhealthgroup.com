---
/**
 * What has actually happened, newest first.
 *
 * This page exists to be checkable. Every entry describes work that has
 * landed; anything still intended lives on a health-area page under "Coming
 * up". If the two ever disagree, this page is the one that must be right.
 */

import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import Icon from "../components/Icon.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import {
  updatesByDate,
  updateKindLabels,
  formatUpdateDate,
} from "../data/updates";
import { programs } from "../data/programs";

const areaName = (id?: string) =>
  id ? programs.find((p) => p.id === id)?.area : undefined;
const areaHref = (id?: string) => (id ? `/programs/${id}/` : undefined);
---

<Base
  title="Updates"
  description="What Tether Health Group has actually built and changed, newest first. Work that is only intended appears on the health-area pages, not here."
>
  <PageHero
    eyebrow="Updates"
    title="What has actually changed."
    intro="Only work that has landed appears here. Anything we intend to do sits under “Coming up” on the health area it belongs to, so the two are never confused."
  />

  <Section width="default">
    <ol class="grid gap-6">
      {
        updatesByDate.map((update) => (
          <li class="rounded-3xl border border-hairline-soft bg-paper p-7 sm:p-8">
            <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:gap-6">
              <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-mint text-teal-deep">
                <Icon name={update.icon} size={22} />
              </span>
              <div>
                <div class="flex flex-wrap items-center gap-3">
                  <time
                    datetime={update.date}
                    class="text-[0.8rem] font-extrabold uppercase tracking-[0.12em] text-teal-mid"
                  >
                    {formatUpdateDate(update.date)}
                  </time>
                  <span class="rounded-full bg-mint-pale px-3 py-1 text-[0.65rem] font-extrabold uppercase tracking-[0.12em] text-teal-mid ring-1 ring-hairline-soft">
                    {updateKindLabels[update.kind]}
                  </span>
                  {areaName(update.area) && (
                    <a
                      href={areaHref(update.area)}
                      class="rounded-full bg-paper px-3 py-1 text-[0.65rem] font-extrabold uppercase tracking-[0.12em] text-teal-deep underline decoration-mint-strong decoration-2 underline-offset-4 ring-1 ring-hairline-soft"
                    >
                      {areaName(update.area)}
                    </a>
                  )}
                </div>
                <h2 class="mt-3 text-xl sm:text-2xl">{update.title}</h2>
                <p class="mt-2 leading-relaxed text-teal-mid">{update.body}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="mt-10 max-w-2xl leading-relaxed text-teal-mid">
      This list starts where the public record does. We are not backfilling a
      history that was never published.
    </p>
  </Section>

  <Section tone="mint" width="default" id="waitlist">
    <div class="mb-10 max-w-2xl">
      <p class="eyebrow mb-5">Early access</p>
      <h2 class="text-3xl sm:text-4xl">Hear about the next one.</h2>
      <p class="mt-5 leading-relaxed text-teal-mid">
        We write when something real changes, and not otherwise.
      </p>
    </div>
    <WaitlistForm />
  </Section>
</Base>
