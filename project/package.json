{
  "name": "project",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --experimental-strip-types --test \"test/**/*.test.js\"",
    "test:unit": "node --experimental-strip-types --test test/unit/*.test.js",
    "test:integration": "node --experimental-strip-types --test test/integration/*.test.js",
    "test:functional": "node --experimental-strip-types --test test/functional/*.test.js",
    "test:smoke": "node --experimental-strip-types --test test/smoke/*.test.js",
    "test:regression": "node --experimental-strip-types --test test/regression/*.test.js",
    "test:acceptance": "node --experimental-strip-types --test test/acceptance/*.test.js",
    "test:security": "node --experimental-strip-types --test test/security/*.test.js",
    "test:ui": "node --experimental-strip-types --test test/ui/*.test.js",
    "test:e2e": "node --experimental-strip-types --test test/e2e/*.test.js",
    "test:performance": "node --experimental-strip-types --test test/performance/*.test.js"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
}
