{
  "name": "tetherhealthgroup-site",
  "version": "1.0.0",
  "private": true,
  "description": "Repository root for www.tetherhealthgroup.com. The site itself lives in the project/ workspace, per the project scaffold; this file exists so the verification gate can discover and run the site's checks from the repository root.",
  "workspaces": [
    "project"
  ],
  "scripts": {
    "dev": "npm run dev --workspace project",
    "build": "npm run build --workspace project",
    "preview": "npm run preview --workspace project",
    "check": "npm run check --workspace project",
    "lint": "npm run lint --workspace project",
    "format": "npm run format --workspace project",
    "test": "npm run test --workspace project",
    "test:unit": "npm run test:unit --workspace project",
    "test:integration": "npm run test:integration --workspace project",
    "test:functional": "npm run test:functional --workspace project",
    "test:smoke": "npm run test:smoke --workspace project",
    "test:regression": "npm run test:regression --workspace project",
    "test:acceptance": "npm run test:acceptance --workspace project",
    "test:security": "npm run test:security --workspace project",
    "test:ui": "npm run test:ui --workspace project",
    "test:e2e": "npm run test:e2e --workspace project",
    "test:performance": "npm run test:performance --workspace project",
    "check:lockfile-libc": "node scripts/check-lockfile-libc.mjs",
    "deploy": "bash scripts/deploy.sh"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  }
}
